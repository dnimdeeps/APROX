# Copy this file to server/.env and fill in your values

# Operator EOA private key — pushes BTC price on-chain every second
# Fund this wallet with Arc Testnet USDC (for gas + reserve seeding)
OPERATOR_PRIVATE_KEY=0xyour_operator_private_key

# Address of the operator wallet (derived from OPERATOR_PRIVATE_KEY)
OPERATOR_GATEWAY_ADDRESS=0xyour_operator_address

# Deployed contract addresses (Arc Testnet — already deployed)
MOCK_PRICE_FEED_ADDRESS=0xa3c98bef3e38b7df28d65fd16c50f156b7601017
APROX_PERP_ADDRESS=0x05ba5e35c8db4167611fb9eb76d0ff184381804f

PORT=3001

# Optional: enables real x402 Gateway payments (testnet = simulation mode)
# NETWORK=mainnet

# Optional: buyer wallet for real x402 payments (mainnet only)
# BUYER_PRIVATE_KEY=0xyour_buyer_private_key
# BUYER_ADDRESS=0xyour_buyer_address
